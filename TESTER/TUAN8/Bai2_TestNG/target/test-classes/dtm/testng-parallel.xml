<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo_Parallel_Suite" verbose="1" parallel="classes" thread-count="2">
    <parameter name="baseUrl" value="https://www.saucedemo.com"/>
    <parameter name="browser" value="chrome"/>

    <test name="Parallel Login And Cart">
        <classes>
            <class name="dtm.LoginTest"/>
            <class name="dtm.CartTest"/>
        </classes>
    </test>
</suite>